#!/bin/sh
# 커밋 단계의 무거운 검사: 전체 문법 + 테스트 (테스트 명령은 .claude/harness.json 의 testCommand)
node .claude/hooks/check-syntax-all.js || exit 1
TEST_CMD=$(node -e "try{process.stdout.write(String(require('./.claude/harness.json').testCommand||''))}catch{}")
if [ -z "$TEST_CMD" ]; then
  echo "pre-commit: .claude/harness.json 의 testCommand 가 비어 있습니다. 사람이 테스트 명령을 채운 뒤 커밋하세요 (USER_GUIDE '설치 후 설정')." >&2
  exit 1
fi
sh -c "$TEST_CMD" || { echo "pre-commit: 테스트 실패 ($TEST_CMD) — 코드를 고친 뒤 다시 커밋하세요." >&2; exit 1; }
